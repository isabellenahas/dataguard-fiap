      "source": [
        "# Validação da regra de violação do OLA\n",
        "\n",
        "df_kpi = df[kpi_real].copy()\n",
        "\n",
        "limite_segundos = {\n",
        "    \"1 - Crítica\": 4 * 60 * 60,\n",
        "    \"2 - Alta\": 4 * 60 * 60,\n",
        "    \"3 - Média\": 12 * 60 * 60\n",
        "}\n",
        "\n",
        "df_kpi[\"Limite_OLA_seg\"] = df_kpi[\"Prioridade\"].map(limite_segundos)\n",
        "\n",
        "df_kpi[\"Violacao_Calculada\"] = (\n",
        "    df_kpi[\"Duração\"] > df_kpi[\"Limite_OLA_seg\"]\n",
        ")\n",
        "\n",
        "df_kpi[\"Violacao_Registrada\"] = (\n",
        "    df_kpi[\"KPI Violado?\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.upper()\n",
        "    .eq(\"SIM\")\n",
        ")\n",
        "\n",
        "divergencias_ola = (\n",
        "    df_kpi[\"Violacao_Calculada\"]\n",
        "    != df_kpi[\"Violacao_Registrada\"]\n",
        ")\n",
        "\n",
        "print(\"VALIDAÇÃO DA REGRA DE VIOLAÇÃO DE OLA\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"Incidentes avaliados:\", len(df_kpi))\n",
        "print(\"Violações registradas:\", df_kpi[\"Violacao_Registrada\"].sum())\n",
        "print(\"Violações calculadas: \", df_kpi[\"Violacao_Calculada\"].sum())\n",
        "print(\"Divergências:         \", divergencias_ola.sum())\n",
        "\n",
        "if divergencias_ola.sum() > 0:\n",
        "    print(\"\\nAmostra das divergências:\")\n",
        "    display(\n",
