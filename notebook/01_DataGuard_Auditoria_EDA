        "def contar_sinais_24h(evento, base):\n",
        "    ic = evento[\"Item de configuração\"]\n",
        "    instante = evento[\"Aberto\"]\n",
        "\n",
        "    inicio = instante - pd.Timedelta(hours=24)\n",
        "\n",
        "    janela = base[\n",
        "        (base[\"Item de configuração\"] == ic)\n",
        "        & (base[\"Aberto\"] >= inicio)\n",
        "        & (base[\"Aberto\"] < instante)\n",
        "    ]\n",
        "\n",
        "    qtd_p4p5 = janela[\n",
        "        janela[\"Prioridade\"].isin([\n",
        "            \"4 - Baixa\",\n",
        "            \"5 - Muito Baixa\"\n",
        "        ])\n",
        "    ].shape[0]\n",
        "\n",
        "    qtd_sem_intervencao = janela[\n",
        "        janela[\"Status\"] == \"Sem Intervenção\"\n",
        "    ].shape[0]\n",
        "\n",
        "    qtd_monitoramento = janela[\n",
        "        janela[\"Aberto por\"] == \"Monitoramento\"\n",
        "    ].shape[0]\n",
        "\n",
        "    return pd.Series({\n",
        "        \"P4P5_24h\": qtd_p4p5,\n",
        "        \"SemIntervencao_24h\": qtd_sem_intervencao,\n",
        "        \"Monitoramento_24h\": qtd_monitoramento\n",
        "    })"
      ],
      "metadata": {
        "id": "s8EzdpY5avUp"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "sinais_criticos = eventos_criticos.apply(\n",
