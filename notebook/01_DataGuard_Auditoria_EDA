      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def avaliar_classificacao(nome, modelo, X_teste, y_teste):\n",
        "\n",
        "    pred = modelo.predict(X_teste)\n",
        "\n",
        "    if hasattr(modelo, \"predict_proba\"):\n",
        "        prob = modelo.predict_proba(X_teste)[:, 1]\n",
        "    else:\n",
        "        prob = pred\n",
        "\n",
        "    return {\n",
        "        \"Modelo\": nome,\n",
        "        \"Precision\": round(\n",
        "            precision_score(y_teste, pred, zero_division=0), 3\n",
        "        ),\n",
        "        \"Recall\": round(\n",
        "            recall_score(y_teste, pred, zero_division=0), 3\n",
        "        ),\n",
        "        \"F1\": round(\n",
        "            f1_score(y_teste, pred, zero_division=0), 3\n",
        "        ),\n",
        "        \"ROC_AUC\": round(\n",
        "            roc_auc_score(y_teste, prob), 3\n",
        "        ),\n",
        "        \"PR_AUC\": round(\n",
        "            average_precision_score(y_teste, prob), 3\n",
        "        )\n",
        "    }"
      ],
      "metadata": {
        "id": "4rhlEHhZdf6Q"
      },
      "execution_count": null,
      "outputs": []
    },
