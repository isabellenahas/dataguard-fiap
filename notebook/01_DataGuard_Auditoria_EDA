        "    elif score >= 75:\n",
        "        return \"ALTO\"\n",
        "\n",
        "    elif score >= 50:\n",
        "        return \"ATENÇÃO\"\n",
        "\n",
        "    else:\n",
        "        return \"BAIXO\"\n",
        "\n",
        "\n",
        "ranking_ola_output[\"Faixa_Risco\"] = (\n",
