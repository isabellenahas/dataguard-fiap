        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error\n",
        ")\n",
        "\n",
        "import numpy as np"
      ],
      "metadata": {
        "id": "xvzX9q5-esYd"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def avaliar_forecast(real, previsto, nome):\n",
        "\n",
        "    mae = mean_absolute_error(real, previsto)\n",
        "\n",
        "    rmse = np.sqrt(\n",
        "        mean_squared_error(real, previsto)\n",
        "    )\n",
        "\n",
        "    mape = (\n",
        "        np.abs(\n",
        "            (real - previsto) / real\n",
        "        ).mean() * 100\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"Modelo\": nome,\n",
        "        \"MAE\": round(mae, 2),\n",
        "        \"RMSE\": round(rmse, 2),\n",
        "        \"MAPE_%\": round(mape, 2)\n",
        "    }"
      ],
      "metadata": {
        "id": "5xzQHeCmetd5"
      },
      "execution_count": null,
      "outputs": []
    },
