      "source": [
        "preprocessador_ola = ColumnTransformer(\n",
        "    transformers=[\n",
        "        (\n",
        "            \"cat\",\n",
        "            OneHotEncoder(\n",
        "                handle_unknown=\"ignore\"\n",
        "            ),\n",
        "            categoricas\n",
        "        ),\n",
        "        (\n",
        "            \"num\",\n",
        "            StandardScaler(),\n",
        "            numericas\n",
        "        )\n",
        "    ]\n",
        ")"
      ],
